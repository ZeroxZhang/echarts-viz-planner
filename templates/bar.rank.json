    "trigger": "axis"
  },
  "series": [
    {
      "type": "bar",
      "barMaxWidth": 24,
      "encode": {
        "x": "__Y__",
        "y": "__X__"
      }
    }
  ],
  "aria": {
    "enabled": true
  }
}