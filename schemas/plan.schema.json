{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "echarts-viz-planner/plan.schema.json",
  "title": "echarts-viz-planner api 模式输出契约",
  "description": "api 1.0 保持兼容；1.1 可选择 decision 或 implementation。语义与引用可读性由 validate_plan.py 检查。",
  "type": "object",
  "required": [
    "contract_version",
    "mode",
    "status",
    "summary",
    "echarts",
    "intent",
    "data",
    "plan"
  ],
  "additionalProperties": true,
  "properties": {
    "contract_version": {
      "type": "string",
      "enum": [
        "1.0",
        "1.1"
      ]
    },
    "mode": {
      "type": "string",
      "const": "api"
    },
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "ok_with_assumptions",
        "insufficient_data",
        "unsupported",
        "policy_blocked"
      ]
    },
    "summary": {
      "type": "string"
    },
    "echarts": {
      "type": "object",
      "required": [
        "version",
        "deps",
        "renderer"
      ],
      "additionalProperties": true,
      "properties": {
        "version": {
          "type": "string",
          "const": "6.1.0"
        },
        "deps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "renderer": {
          "type": "string",
          "enum": [
            "canvas",
            "svg"
          ]
        }
      }
    },
    "intent": {
      "type": "object",
      "required": [
        "goal",
        "scenario",
        "inferred",
        "confidence"
      ],
      "additionalProperties": true,
      "properties": {
        "goal": {
          "type": "string"
        },
        "scenario": {
          "type": "string",
          "enum": [
            "review",
            "executive",
            "exploration",
            "broadcast",
            "monitoring"
          ]
        },
        "inferred": {
          "type": "boolean"
        },
        "confidence": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ]
        }
      }
    },
    "data": {
      "type": "object",
      "required": [
        "ref",
        "profile",
        "binding"
      ],
      "additionalProperties": true,
      "properties": {
        "ref": {
          "type": "object",
          "required": [
            "type"
          ],
          "additionalProperties": true,
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "inline",
                "file",
                "lark_sheet",
                "bitable",
                "aeolus",
                "hive",
                "lark_doc",
                "none"
              ]
            },
            "id": {
              "type": "string"
            }
          }
        },
        "profile": {
          "type": "object",
          "required": [
            "rows",
            "dimensions",
            "measures"
          ],
          "additionalProperties": true,
          "properties": {
            "rows": {
              "type": "integer",
              "minimum": 0
            },
            "dimensions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "measures": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "time_field": {
              "type": [
                "string",
                "null"
              ]
            },
            "cardinality": {
              "type": "object",
              "additionalProperties": {
                "type": "integer"
              }
            }
          }
        },
        "binding": {
          "type": "object",
          "required": [
            "mode",
            "expects",
            "required_fields"
          ],
          "additionalProperties": true,
          "properties": {
            "mode": {
              "type": "string",
              "const": "dataset.source"
            },
            "expects": {
              "type": "string"
            },
            "required_fields": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "transform_policy": {
          "type": "string",
          "enum": [
            "propose",
            "apply"
          ],
          "default": "propose"
        }
      }
    },
    "plan": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "required": [
          "role",
          "capability_id",
          "question",
          "match"
        ],
        "additionalProperties": true,
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "primary",
              "support"
            ]
          },
          "capability_id": {
            "type": "string"
          },
          "question": {
            "type": "string"
          },
          "match": {
            "type": "string",
            "enum": [
              "strong",
              "medium",
              "weak"
            ]
          },
          "encode": {
            "type": "object"
          },
          "transforms": {
            "type": "array"
          },
          "option": {
            "type": "object",
            "properties": {
              "series": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "type"
                  ],
                  "properties": {
                    "type": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          },
          "carrier_adaptation": {
            "type": "object"
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "spec": {
            "type": "object",
            "required": [
              "kind",
              "message",
              "evidence_refs",
              "boundaries"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "echarts",
                  "table",
                  "text",
                  "infographic",
                  "kpi"
                ]
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "boundaries": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "mapping": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "minItems": 1
                    }
                  ]
                }
              },
              "comparison_basis": {
                "type": "string",
                "minLength": 1
              },
              "columns": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "field",
                    "label"
                  ],
                  "properties": {
                    "field": {
                      "type": "string",
                      "minLength": 1
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              "row_organization": {
                "type": "string",
                "minLength": 1
              },
              "lookup_task": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "structure": {
                "type": "object",
                "minProperties": 1
              },
              "relationship_semantics": {
                "type": "string",
                "minLength": 1
              },
              "reading_order": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "metric": {
                "type": "string",
                "minLength": 1
              },
              "format": {
                "type": "string",
                "minLength": 1
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "echarts"
                    }
                  }
                },
                "then": {
                  "required": [
                    "mapping",
                    "comparison_basis"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "table"
                    }
                  }
                },
                "then": {
                  "required": [
                    "columns",
                    "row_organization",
                    "lookup_task"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "text"
                    }
                  }
                },
                "then": {
                  "required": [
                    "text"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "infographic"
                    }
                  }
                },
                "then": {
                  "required": [
                    "structure",
                    "relationship_semantics",
                    "reading_order"
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "kind": {
                      "const": "kpi"
                    }
                  }
                },
                "then": {
                  "required": [
                    "metric",
                    "comparison_basis",
                    "format"
                  ]
                }
              }
            ]
          },
          "spec_ref": {
            "type": "object",
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "bindings": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "target",
                "ref",
                "expects",
                "required_fields"
              ],
              "properties": {
                "target": {
                  "type": "string",
                  "minLength": 1
                },
                "ref": {
                  "type": "object",
                  "required": [
                    "type",
                    "id"
                  ],
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "inline",
                        "file",
                        "lark_sheet",
                        "bitable",
                        "aeolus",
                        "hive",
                        "lark_doc",
                        "none"
                      ]
                    },
                    "id": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "expects": {
                  "type": "string",
                  "minLength": 1
                },
                "required_fields": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          },
          "implementation_ref": {
            "type": "object",
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "capability_id",
          "when_better"
        ],
        "additionalProperties": true,
        "properties": {
          "capability_id": {
            "type": "string"
          },
          "when_better": {
            "type": "string"
          }
        }
      }
    },
    "rejected": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "capability_id",
          "reason"
        ],
        "additionalProperties": true,
        "properties": {
          "capability_id": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "item",
          "impact",
          "reversible"
        ],
        "additionalProperties": true,
        "properties": {
          "item": {
            "type": "string"
          },
          "impact": {
            "type": "string",
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "reversible": {
            "type": "boolean"
          }
        }
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "q",
          "default_used",
          "blocking"
        ],
        "additionalProperties": true,
        "properties": {
          "q": {
            "type": "string"
          },
          "default_used": {
            "type": "string"
          },
          "impact": {
            "type": "string"
          },
          "blocking": {
            "type": "boolean",
            "const": false
          }
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verify_hints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "missing": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "what",
          "why_needed",
          "how_to_get"
        ],
        "additionalProperties": true,
        "properties": {
          "what": {
            "type": "string"
          },
          "why_needed": {
            "type": "string"
          },
          "how_to_get": {
            "type": "string"
          }
        }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "candidates": {
          "type": "integer",
          "minimum": 0
        },
        "rejected": {
          "type": "integer",
          "minimum": 0
        },
        "reviewed_pairs": {
          "type": "integer",
          "minimum": 0
        },
        "catalog_coverage": {
          "type": "string",
          "enum": [
            "full",
            "partial"
          ]
        }
      }
    },
    "output_level": {
      "type": "string",
      "enum": [
        "implementation",
        "decision"
      ],
      "default": "implementation"
    },
    "context": {
      "type": "object",
      "properties": {
        "reader_task": {
          "type": "string",
          "minLength": 1
        },
        "findings": {
          "type": "array"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "boundaries": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "constraints": {
      "type": "object",
      "properties": {
        "static": {
          "type": "boolean"
        },
        "offline": {
          "type": "boolean"
        },
        "size": {
          "type": "object"
        },
        "runtime": {
          "type": "object"
        },
        "theme": {
          "type": [
            "string",
            "object"
          ]
        },
        "allow_extensions": {
          "type": "boolean"
        },
        "allow_3d": {
          "type": "boolean"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "ok",
              "ok_with_assumptions",
              "policy_blocked"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "plan": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "ok_with_assumptions"
          }
        }
      },
      "then": {
        "required": [
          "assumptions"
        ],
        "properties": {
          "assumptions": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "insufficient_data"
          }
        }
      },
      "then": {
        "required": [
          "missing"
        ],
        "properties": {
          "missing": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "contract_version": {
            "const": "1.0"
          }
        }
      },
      "then": {
        "properties": {
          "output_level": {
            "const": "implementation"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "contract_version": {
            "const": "1.1"
          }
        }
      },
      "then": {
        "properties": {
          "plan": {
            "items": {
              "required": [
                "rationale"
              ],
              "oneOf": [
                {
                  "required": [
                    "spec"
                  ],
                  "not": {
                    "required": [
                      "spec_ref"
                    ]
                  }
                },
                {
                  "required": [
                    "spec_ref"
                  ],
                  "not": {
                    "required": [
                      "spec"
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    }
  ]
}
